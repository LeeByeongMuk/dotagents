#!/usr/bin/env bash
# Git commit-msg wrapper. Link it into the active hooks directory or install
# it alongside check.sh there.
set -euo pipefail
source_path="${BASH_SOURCE[0]}"
[[ "$source_path" == /* ]] || source_path="$PWD/$source_path"
while [[ -L "$source_path" ]]; do
  source_dir="$(cd "$(dirname "$source_path")" && pwd -P)"
  source_path="$(readlink "$source_path")"
  [[ "$source_path" == /* ]] || source_path="$source_dir/$source_path"
done
here="$(cd "$(dirname "$source_path")" && pwd -P)"
DOTAGENTS_REPO_DIR="$PWD" exec "$here/check.sh" "$1"
