{
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "disableClaudeAiConnectors": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.agents/hooks/commit-message/pre-tool-use.sh"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "statusLine": {
    "type": "command",
    "command": "bash -c 'd=\"$(ls -td ~/.claude/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | head -1)\"; n=/opt/homebrew/bin/node; [ -x \"$n\" ] || n=\"$(command -v node)\"; if [ -n \"$d\" ] && [ -f \"${d}dist/index.js\" ] && [ -n \"$n\" ]; then exec \"$n\" \"${d}dist/index.js\"; fi'"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
